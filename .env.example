# Environment variables for TradeDash

# Binance API (optional if using public endpoints)
# VITE_BINANCE_API_KEY=
# VITE_BINANCE_API_SECRET=

# Bybit API (optional if using public endpoints)
# VITE_BYBIT_API_KEY=
# VITE_BYBIT_API_SECRET=

# App configuration
VITE_APP_NAME=TradeDash
VITE_APP_VERSION=0.1.0
VITE_DEFAULT_SYMBOL=BTCUSDT
VITE_DEFAULT_TIMEFRAME=1h

# Feature flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_LOGGING=false